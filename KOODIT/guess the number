import random
number = random.randint(0,100)
guess = -1
count = 0
print ("Guess the number!")
while guess != number:
    guess = int(input("Is it..."))
    count = count + 1
    if guess == number:
        print("Hooray!, You guessed it right!")
    elif guess < number:
        print("It's bigger...")
    elif guess > number:
        print("It's not so big.")
if count > 3:
    print("That must have been complicated.")
else:
    print("Good Job!")                    